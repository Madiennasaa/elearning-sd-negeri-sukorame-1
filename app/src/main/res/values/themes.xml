<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Elearning_SD_Negeri_Sukorame_1" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary_purple</item>
        <item name="colorPrimaryVariant">@color/primary_purple_light</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="colorSurface">@color/card_bg</item>
        <item name="colorOnSurface">@color/text_dark</item>
        <item name="android:colorBackground">@color/bg_light</item>
        <item name="android:textColorPrimary">@color/text_dark</item>
        <item name="android:textColorSecondary">@color/text_gray</item>
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="android:statusBarColor">@color/bg_light</item>
        <item name="android:navigationBarColor">@color/bg_light</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">true</item>
        <item name="cardBackgroundColor">@color/card_bg</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="colorControlNormal">@color/text_hint</item>
        <item name="colorControlActivated">@color/primary_purple</item>
        <item name="colorControlHighlight">@color/light_purple</item>
        <item name="android:listDivider">@color/divider_color</item>
    </style>

    <!-- Custom theme for SearchView to ensure text is visible on white background -->
    <style name="SearchViewTheme" parent="Widget.AppCompat.SearchView">
        <item name="android:editTextColor">#1A1A2E</item>
        <item name="android:textColorHint">#9E9EB8</item>
        <item name="colorControlNormal">#1A1A2E</item>
    </style>

    <style name="Theme.Elearning.Splash" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:statusBarColor">@color/splash_bg</item>
        <item name="android:navigationBarColor">@color/splash_bg</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>
        <item name="android:windowFullscreen">false</item>
    </style>

    <style name="Theme.Elearning.Login" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:statusBarColor">@color/login_bg_top</item>
        <item name="android:navigationBarColor">@color/login_bg_top</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>
        <item name="colorPrimary">@color/login_accent</item>
        <item name="colorControlActivated">@color/login_accent</item>
    </style>
</resources>
