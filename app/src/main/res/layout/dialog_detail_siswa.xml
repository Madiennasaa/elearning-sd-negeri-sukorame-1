<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvDetailNamaSiswa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nama Siswa"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_dark"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tvDetailNisnSiswa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="NISN: -"
            android:textSize="14sp"
            android:textColor="@color/item_muted_text"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nilai"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/label_blue"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tvDetailNilaiSiswa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="-"
            android:textSize="13sp"
            android:textColor="@color/text_dark"
            android:layout_marginBottom="16dp"
            android:background="@color/accent_blue_chip"
            android:padding="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Absensi"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/label_blue"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tvDetailAbsensiSiswa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="-"
            android:textSize="13sp"
            android:textColor="@color/text_dark"
            android:background="@color/accent_blue_chip"
            android:padding="8dp"/>

    </LinearLayout>

</ScrollView>