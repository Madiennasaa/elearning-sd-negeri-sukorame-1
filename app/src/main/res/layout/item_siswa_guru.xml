<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/card_bg">

    <LinearLayout
        android:id="@+id/rowSiswa"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="14dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <!-- Strip kiri — reuse bg_strip_rounded -->
        <View
            android:id="@+id/stripSiswa"
            android:layout_width="5dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_strip_rounded"/>

        <!-- Avatar inisial -->
        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_icon_box_white"
            android:backgroundTint="@color/icon_box_purple_tint">
            <TextView
                android:id="@+id/tvInisial"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="A"
                android:textColor="@color/primary_purple"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-rounded"/>
        </FrameLayout>

        <!-- Info siswa -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/tvNamaSiswa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nama Siswa"
                android:textColor="@color/text_dark"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-rounded"/>

            <TextView
                android:id="@+id/tvNisnSiswa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="NISN: 0012345678"
                android:textColor="@color/text_gray"
                android:textSize="12sp"
                android:fontFamily="sans-serif-rounded"/>
        </LinearLayout>

        <!-- Badge nomor urut -->
        <FrameLayout
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_icon_box_white"
            android:backgroundTint="@color/icon_box_purple_tint">
            <TextView
                android:id="@+id/tvNomor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="1"
                android:textColor="@color/primary_purple"
                android:textSize="11sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-rounded"/>
        </FrameLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>