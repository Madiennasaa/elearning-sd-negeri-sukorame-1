<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_light">

    <!-- HEADER -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:background="@color/primary_purple">

        <View
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="-25dp"
            android:layout_marginEnd="-25dp"
            android:background="@drawable/bg_circle_light_blue"
            android:alpha="0.15"/>

        <View
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="-18dp"
            android:layout_marginBottom="-18dp"
            android:background="@drawable/bg_circle_pink"
            android:alpha="0.18"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="24dp"
            android:paddingTop="16dp"
            android:paddingBottom="20dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_back"
                android:background="@drawable/bg_pill_white_alpha"
                android:padding="8dp"
                app:tint="@color/on_header_title"
                android:contentDescription="Kembali"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Daftar Siswa"
                android:textColor="@color/on_header_title"
                android:textSize="22sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-rounded"/>

            <TextView
                android:id="@+id/tvNamaKelasDaftarSiswa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Data siswa terdaftar di kelas ini"
                android:textColor="@color/admin_header_chip"
                android:textSize="12sp"
                android:fontFamily="sans-serif-rounded"/>
        </LinearLayout>
    </FrameLayout>

    <!-- SEARCH BAR — custom biar konsisten -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp"
        android:background="@color/bg_light">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="44dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/card_bg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@android:drawable/ic_menu_search"
                    app:tint="@color/primary_purple"/>

                <androidx.appcompat.widget.SearchView
                    android:id="@+id/searchSiswa"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    app:queryHint="Cari nama siswa..."
                    app:iconifiedByDefault="false"
                    app:searchIcon="@null"
                    app:queryBackground="@android:color/transparent"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <!-- COUNTER CHIP -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingBottom="8dp">

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:background="@drawable/bg_chip_orange"
            android:backgroundTint="@color/icon_box_purple_tint"
            android:paddingHorizontal="12dp">
            <TextView
                android:id="@+id/tvJumlahSiswa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="0 Siswa"
                android:textColor="@color/primary_purple"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-rounded"/>
        </FrameLayout>
    </LinearLayout>

    <!-- EMPTY STATE -->
    <LinearLayout
        android:id="@+id/layoutEmptyDaftarSiswa"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="48dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="👥"
            android:textSize="48sp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Belum ada siswa terdaftar"
            android:textColor="@color/text_dark"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-rounded"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Data siswa akan muncul di sini"
            android:textColor="@color/text_gray"
            android:textSize="13sp"
            android:fontFamily="sans-serif-rounded"/>
    </LinearLayout>

    <!-- LIST -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvDaftarSiswa"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="16dp"
        android:paddingBottom="24dp"
        android:clipToPadding="false"/>

</LinearLayout>