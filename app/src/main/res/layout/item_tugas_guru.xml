<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/card_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvJudulTugasItem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Judul Tugas"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_dark"
                    android:fontFamily="sans-serif-rounded"/>

                <TextView
                    android:id="@+id/tvMapelTugasItem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Mata Pelajaran"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary_purple"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif-rounded"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="6dp">

                    <TextView
                        android:id="@+id/tvDeadlineTugasItem"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Deadline: -"
                        android:textSize="12sp"
                        android:textColor="@color/item_delete_icon"
                        android:fontFamily="sans-serif-rounded"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="  •  "
                        android:textSize="12sp"
                        android:textColor="@color/item_secondary_text"/>

                    <TextView
                        android:id="@+id/tvJumlahSoalItem"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 soal"
                        android:textSize="12sp"
                        android:textColor="@color/item_online_dot"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-rounded"/>
                </LinearLayout>

            </LinearLayout>

            <ImageButton
                android:id="@+id/btnDeleteTugas"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_menu_delete"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/item_delete_icon"
                android:padding="8dp"/>

        </LinearLayout>

        <Button
            android:id="@+id/btnTambahSoal"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="+ Kelola Soal"
            android:layout_marginTop="12dp"
            android:textColor="@color/primary_purple"
            android:backgroundTint="@color/icon_box_purple_tint"
            app:cornerRadius="8dp"
            android:textStyle="bold"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"/>

    </LinearLayout>

</androidx.cardview.widget.CardView>