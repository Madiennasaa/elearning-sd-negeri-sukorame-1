<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/login_bg_top"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="100dp">

        <!-- BG dekor lingkaran atas -->
        <View
            android:id="@+id/circleTopRight"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:background="@drawable/bg_circle_light_blue"
            android:alpha="0.15"
            android:layout_marginTop="-60dp"
            android:layout_marginEnd="-60dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Header logo + nama app -->
        <LinearLayout
            android:id="@+id/headerSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="60dp"
            android:paddingBottom="32dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.cardview.widget.CardView
                android:layout_width="100dp"
                android:layout_height="100dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="12dp"
                app:cardBackgroundColor="@color/card_bg">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="12dp"
                    android:src="@drawable/ic_tut_wuri"
                    android:scaleType="fitCenter"/>
            </androidx.cardview.widget.CardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="SIMAS E-LEARNING"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:fontFamily="sans-serif-rounded"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="SD Negeri Sukorame 1"
                android:textColor="@color/on_header_sub_blue"
                android:textSize="13sp"
                android:fontFamily="sans-serif-rounded"/>
        </LinearLayout>

        <!-- Form card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/formCard"
            android:layout_width="340dp"
            android:layout_height="wrap_content"
            app:cardCornerRadius="32dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/login_form_bg"
            app:layout_constraintTop_toBottomOf="@id/headerSection"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="28dp"
                android:paddingTop="36dp"
                android:paddingBottom="40dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Selamat Datang!"
                    android:textColor="@color/text_dark"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-rounded"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Masuk untuk mulai belajar hari ini"
                    android:textColor="@color/login_subtitle_text"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-rounded"/>

                <View
                    android:layout_width="40dp"
                    android:layout_height="4dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="28dp"
                    android:background="@drawable/bg_strip_rounded"
                    android:backgroundTint="@color/login_accent"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NISN / Email"
                    android:textColor="@color/text_dark"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp"
                    android:fontFamily="sans-serif-rounded"/>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Masukkan NISN atau Email"
                    android:textColorHint="@color/login_hint"
                    app:startIconDrawable="@drawable/ic_people"
                    app:startIconTint="@color/login_accent"
                    app:boxStrokeColor="@color/login_accent"
                    app:hintTextColor="@color/login_accent"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etNisn"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:textColor="@color/text_dark"
                        android:textSize="15sp"
                        android:fontFamily="sans-serif-rounded"/>
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kata Sandi"
                    android:textColor="@color/text_dark"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="6dp"
                    android:fontFamily="sans-serif-rounded"/>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Masukkan kata sandi"
                    android:textColorHint="@color/login_hint"
                    app:startIconDrawable="@drawable/ic_star"
                    app:startIconTint="@color/login_accent"
                    app:boxStrokeColor="@color/login_accent"
                    app:hintTextColor="@color/login_accent"
                    app:passwordToggleEnabled="true"
                    app:passwordToggleTint="@color/login_accent"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"
                        android:textColor="@color/text_dark"
                        android:textSize="15sp"
                        android:fontFamily="sans-serif-rounded"/>
                </com.google.android.material.textfield.TextInputLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnLogin"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="Masuk Sekarang"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-rounded"
                        android:backgroundTint="@color/login_btn_bg"
                        app:cornerRadius="16dp"
                        app:icon="@drawable/ic_home"
                        app:iconGravity="textStart"
                        app:iconTint="@color/on_header_title"/>

                    <ProgressBar
                        android:id="@+id/progressBar"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:visibility="gone"
                        android:indeterminateTint="@color/on_header_title"/>
                </FrameLayout>

                <TextView
                    android:id="@+id/tvLupaPassword"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="20dp"
                    android:text="Lupa kata sandi? Hubungi guru kamu"
                    android:textColor="@color/text_gray"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:fontFamily="sans-serif-rounded"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
