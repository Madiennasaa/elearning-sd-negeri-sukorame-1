<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/card_bg">

    <LinearLayout
        android:id="@+id/rowMateri"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <!-- Strip kiri biru — reuse bg_strip_rounded -->
        <View
            android:id="@+id/stripMateri"
            android:layout_width="5dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_strip_rounded"/>

        <!-- Icon box — reuse bg_icon_box_white -->
        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_icon_box_white">

            <ImageView
                android:id="@+id/ivIconMateri"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_book"
                app:tint="@color/header_blue"/>
        </FrameLayout>

        <!-- Teks -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="14dp">

            <TextView
                android:id="@+id/tvJudulMateri"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pengenalan Angka"
                android:textColor="@color/text_dark"
                android:textSize="15sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end"
                android:fontFamily="sans-serif-rounded"/>

            <TextView
                android:id="@+id/tvMapelMateri"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Matematika"
                android:textColor="@color/on_header_sub_yellow"
                android:textSize="12sp"
                android:fontFamily="sans-serif-rounded"/>
        </LinearLayout>

        <!-- Pill "Buka" — reuse bg_pill_white_alpha dengan bg biru -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_chip_blue"
            android:paddingHorizontal="12dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Buka ›"
                android:textColor="@color/header_blue"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-rounded"/>
        </FrameLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>