<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Jenis Mata Pelajaran"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerJenisMapel"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nama Mapel"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etNamaMapel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Contoh: Matematika"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:id="@+id/layoutKhusus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kode Mapel (Khusus)"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etKodeMapel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Contoh: MTK-001"
                android:layout_marginBottom="12dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>