<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="20dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Judul" android:textStyle="bold" android:layout_marginBottom="4dp"/>
    <EditText android:id="@+id/etJudul" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:hint="Judul pengumuman" android:layout_marginBottom="12dp"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Isi Pengumuman" android:textStyle="bold" android:layout_marginBottom="4dp"/>
    <EditText android:id="@+id/etIsi" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:hint="Tulis isi pengumuman..." android:inputType="textMultiLine"
        android:minLines="3" android:layout_marginBottom="12dp"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Kategori" android:textStyle="bold" android:layout_marginBottom="4dp"/>
    <Spinner android:id="@+id/spinnerKategori" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginBottom="12dp"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Ditujukan Untuk" android:textStyle="bold" android:layout_marginBottom="4dp"/>
    <Spinner android:id="@+id/spinnerUntuk" android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>