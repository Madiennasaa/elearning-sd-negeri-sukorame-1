<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <EditText
            android:id="@+id/etPertanyaan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Pertanyaan *"
            android:inputType="textMultiLine"
            android:minLines="3"
            android:gravity="top"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/etPilihanA"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Pilihan A *"
            android:inputType="text"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/etPilihanB"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Pilihan B *"
            android:inputType="text"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/etPilihanC"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Pilihan C (opsional)"
            android:inputType="text"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/etPilihanD"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Pilihan D (opsional)"
            android:inputType="text"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Jawaban Benar:"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_dark"
            android:layout_marginBottom="4dp"/>

        <RadioGroup
            android:id="@+id/rgJawabanBenar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbA"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="A"
                android:layout_marginEnd="8dp"/>

            <RadioButton
                android:id="@+id/rbB"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="B"
                android:layout_marginEnd="8dp"/>

            <RadioButton
                android:id="@+id/rbC"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="C"
                android:layout_marginEnd="8dp"/>

            <RadioButton
                android:id="@+id/rbD"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="D"/>

        </RadioGroup>

    </LinearLayout>

</ScrollView>