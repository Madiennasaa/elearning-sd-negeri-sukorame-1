<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base gradient: deep indigo to midnight blue -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#1A0D35"
                android:centerColor="#0D1540"
                android:endColor="#091230" />
        </shape>
    </item>
</layer-list>
